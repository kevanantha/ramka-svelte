{
  "name": "ramka-svelte-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Svelte port of ramka — unstyled, accessible lightbox primitives — and its documentation site.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter ramka-svelte package && pnpm --filter docs build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
